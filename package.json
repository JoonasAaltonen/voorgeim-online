{
  "name": "voorgeim-online",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "sync-assets": "node scripts/sync-assets.mjs",
    "cf-types": "wrangler types",
    "//dev:worker": "The full stack locally: builds the client, then serves it and the Durable Object from one origin, as in production. Plain `dev` is client-only and stays hotseat.",
    "dev:worker": "npm run build && wrangler dev",
    "//smoke": "End-to-end socket test against a running `dev:worker`, or any origin passed as an argument (`npm run smoke -- https://…`). Not in `test` — it needs a server.",
    "smoke": "node tools/smoke-worker.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.111.0"
  }
}
