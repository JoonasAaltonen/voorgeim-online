{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    /* Workers globals + the bindings wrangler generates from wrangler.jsonc. */
    "types": ["./worker-configuration.d.ts"],
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* The engine is shared: the same rules the client shows are the ones the DO
     enforces, so the worker compiles against those sources directly. Only
     `protocol.ts` is taken from src/net — the rest of that folder is the browser
     half, and pulling it in here would compile DOM code against Workers globals. */
  "include": [
    "worker",
    "src/engine",
    "src/net/protocol.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["src/engine/**/*.test.ts"]
}
